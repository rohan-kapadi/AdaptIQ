# Backend environment variables (DO NOT COMMIT real secrets)

# MongoDB (recommended)
MONGODB_URI='mongodb+srv://<username>:<password>@<cluster-host>/<db>?retryWrites=true&w=majority'

# Optional: database name (defaults to UserTest)
# MONGODB_DB='UserTest'

# Optional: authSource (only needed if your MongoDB user was created on a non-default auth DB)
# MONGODB_AUTH_SOURCE='admin'

# Groq
groq_api='gsk_********************************'

# Optional (defaults to llama-3.1-8b-instant)
# GROQ_MODEL='llama-3.1-8b-instant'

# Optional
# PORT=5000
# FLASK_DEBUG=1
